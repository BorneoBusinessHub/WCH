---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import { Image } from 'astro:assets';
import { photos } from '../data/photos';
import { t, site, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
const { company } = site;
---
<Base locale={locale} path="/contact" title={s.contact_title} description={s.contact_desc}>
  <Hero compact photo="bakun" credit={s.credit_bakun} eyebrow={s.contact_eyebrow} title={s.contact_h1} lead={s.contact_lead} />
  <section class="section">
    <div class="wrap grid grid-2" style="align-items:start">
      <div class="reveal"><ContactForm locale={locale} /></div>
      <div class="card reveal">
        <h2 style="font-size:1.25rem">{s.contact_direct_title}</h2>
        <ul class="facts-list">
          <li><strong>{s.contact_email_label}</strong><a href={`mailto:${company.email}`}>{company.email}</a></li>
          {company.address && <li><strong>{s.contact_address_label}</strong><span>{company.address}</span></li>}
          <li><strong>{s.contact_web_label}</strong><span>{company.domain}</span></li>
        </ul>
      </div>
      <div></div>
      <figure class="side-photo reveal d1"><Image src={photos.serverHall} alt={s.alt_hall} widths={[600, 900, 1200]} sizes="(min-width: 900px) 45vw, 100vw" format="webp" quality={70} /></figure>
    </div>
  </section>
  <section class="section" style="padding-top:0"><div class="wrap"><figure class="wide-photo reveal"><Image src={photos.land} alt={s.alt_land} widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} /></figure></div></section>
</Base>
