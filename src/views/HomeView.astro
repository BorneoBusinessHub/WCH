---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Slip from '../components/Slip.astro';
import PersonCard from '../components/PersonCard.astro';
import LoadMeter from '../components/LoadMeter.astro';
import SourceNote from '../components/SourceNote.astro';
import { photos } from '../data/photos';
import { t, localePath, site, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale) as Record<string, string>;
const L = (p: string) => localePath(locale, p);
const people = [...site.team, ...site.advisers];
const feats = [
  { k: 'space', photo: photos.switchyard, alt: s.alt_switchyard },
  { k: 'dev', photo: photos.cooling, alt: s.alt_cooling },
  { k: 'host', photo: photos.rack, alt: s.alt_rack },
  { k: 'ops', photo: photos.serverHall, alt: s.alt_hall },
];
---
<Base locale={locale} path="/" title={s.home_title} description={s.home_desc}>
<section class="a-hero">
  <div class="wrap">
    <div class="plate a-plate">
      <div class="a-strip"><span class="lbl">{site.company.name}</span><span class="lbl">{s.bar_left}</span></div>
      <div class="a-main">
        <div class="a-copy">
          <h1>{s.home_h1}</h1>
          <p class="lead">{s.home_lead}</p>
          <div class="btn-row">
            <a class="btn" href={L('/project')}>{s.cta_project}</a>
            <a class="btn ghost" href={L('/contact')}>{s.cta_contact}</a>
          </div>
        </div>
        <dl class="cells a-facts">
          <div><dt class="lbl">{s.fact_contract}</dt><dd class="val">10<small>MW</small></dd></div>
          <div><dt class="lbl">{s.fact_term}</dt><dd class="val">10<small>yr</small></dd></div>
          <div class="hot"><dt class="lbl">{s.fact_phase1}</dt><dd class="val">2<small>MW</small></dd></div>
          <div><dt class="lbl">{s.fact_grid}</dt><dd class="val">5.9<small>GW</small></dd></div>
          <div><dt class="lbl">{s.trk_power_t}</dt><dd class="a-ok">{s.trk_done}</dd></div>
          <div><dt class="lbl">{s.trk_land_t}</dt><dd class="a-ok">{s.trk_done}</dd></div>
        </dl>
      </div>
      <div class="a-strip a-strip-b"><span class="small">{s.trk_note}</span></div>
    </div>
  </div>
</section>

<section class="a-photo">
  <div class="wrap">
    <figure>
      <Image src={photos.bakun} alt={s.alt_dam} widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="eager" />
      <figcaption class="photo-credit">{s.credit_bakun}</figcaption>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="a-why">
  <div class="wrap a-split">
    <h2 id="a-why">{s.why_title}</h2>
    <ul class="facts-list stack">
      <li><strong>{s.home_why_1_t}</strong><span>{s.home_why_1_b}</span></li>
      <li><strong>{s.home_why_2_t}</strong><span>{s.home_why_2_b}</span></li>
      <li><strong>{s.home_land_t}</strong><span>{s.home_land_b}</span></li>
      <li><strong>{s.home_why_3_t}</strong><span>{s.home_why_3_b} <a href={L('/project')}>{s.cta_project}</a></span></li>
    </ul>
    <div class="a-src"><SourceNote locale={locale} /></div>
  </div>
</section>

<section class="section tone" aria-labelledby="a-status">
  <div class="wrap a-split">
    <div><h2 id="a-status">{s.trk_title}</h2><p class="lead">{s.trk_lead}</p></div>
    <div><Slip locale={locale} /></div>
  </div>
</section>

<section class="section" aria-labelledby="a-calc">
  <div class="wrap">
    <div class="section-head"><h2 id="a-calc">{s.calc_title}</h2><p class="lead">{s.calc_lead}</p></div>
    <div><LoadMeter locale={locale} uid="a" /></div>
  </div>
</section>

<section class="section" aria-labelledby="a-feat">
  <div class="wrap">
    <div class="section-head"><h2 id="a-feat">{s.feat_title}</h2><p class="lead">{s.home_build_lead}</p></div>
    <div class="a-feats">
      {feats.map((f) => (
        <article class="a-feat">
          <figure><Image src={f.photo} alt={f.alt} widths={[400, 700]} sizes="(min-width: 900px) 25vw, 100vw" format="webp" quality={70} /></figure>
          <h3>{s[`svc_${f.k}_t`]}</h3>
          <ul>{[1, 2, 3, 4].map((n) => <li>{s[`feat_${f.k}_${n}`]}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="btn-row"><a class="btn" href={L('/services')}>{s.cta_services}</a></div>
  </div>
</section>

<section class="section" aria-labelledby="a-team">
  <div class="wrap">
    <div class="section-head"><h2 id="a-team">{s.home_team_title}</h2><p class="lead">{s.home_team_lead}</p></div>
    <div class="team">{people.map((p, i) => <PersonCard name={p.name} role={s[p.roleKey]} bio={s[p.bioKey]} photo={p.photo} tint={i} delay={i} />)}</div>
  </div>
</section>

<section class="a-mail" aria-labelledby="a-mail">
  <div class="wrap">
    <h2 id="a-mail">{s.contact_sentence}</h2>
    <a class="a-addr" href={`mailto:${site.company.email}`}>{site.company.email}</a>
    <ul class="cells a-routes">
      <li><a href={L('/project')}>{s.route_gov}</a></li>
      <li><a href={L('/work-with-us')}>{s.route_con}</a></li>
      <li><a href={L('/contact') + '?type=partner'}>{s.route_par}</a></li>
    </ul>
  </div>
</section>

</Base>
<style>
  .a-hero { padding: 24px 0 0; }
  .a-plate { padding: 30px 30px 0; }
  .a-strip { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 0 0 14px; border-bottom: var(--line) solid var(--rule); }
  .a-strip-b { border-bottom: 0; border-top: var(--line) solid var(--rule); padding: 14px 0 22px; }
  .a-strip-b .small { margin: 0; }
  .a-main { display: grid; gap: 32px; padding: 40px 0; }
  .a-copy h1 { max-width: 11ch; }
  .a-facts { margin: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); border: var(--line) solid var(--rule); align-self: end; }
  .a-facts > div { display: flex; flex-direction: column; justify-content: space-between; gap: 22px; min-height: 132px; }
  .a-facts dd { margin: 0; }
  .js .a-facts > div { animation: stamp .7s var(--ease) both; }
  .js .a-facts > div:nth-child(2) { animation-delay: .08s; } .js .a-facts > div:nth-child(3) { animation-delay: .16s; } .js .a-facts > div:nth-child(4) { animation-delay: .24s; } .js .a-facts > div:nth-child(5) { animation-delay: .32s; } .js .a-facts > div:nth-child(6) { animation-delay: .4s; }
  @keyframes stamp { from { transform: scale(1.06); box-shadow: 0 10px 24px rgba(11, 31, 51, .25); } 60% { transform: scale(.985); box-shadow: none; } to { transform: none; } }
  .a-src { grid-column: 2; }
  @media (max-width: 899px) { .a-src { grid-column: auto; } }
  .a-facts .val { font-size: clamp(52px, 5vw, 84px); }
  .a-ok { font-weight: 750; font-size: var(--s-lead); display: flex; align-items: center; gap: 10px; }
  .a-ok::before { content: ''; flex: none; width: 18px; height: 18px; background: var(--ink); }
  @media (min-width: 1000px) {
    .a-main { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px; padding: 64px 0 48px; min-height: calc(100svh - 72px - 24px - 140px); align-items: end; }
  }
  .a-photo { padding: 24px 0 0; }
  .a-photo figure { position: relative; margin: 0; aspect-ratio: 21 / 9; border: var(--line) solid var(--rule); overflow: hidden; background: var(--alu); }
  .a-photo img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 759px) { .a-photo figure { aspect-ratio: 4 / 3; } }

  .a-split { display: grid; gap: 32px; }
  @media (min-width: 900px) { .a-split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: start; } .a-split > h2, .a-split > div:first-child { position: sticky; top: 32px; } }

  .a-feats { display: grid; gap: var(--line); background: var(--rule); border: var(--line) solid var(--rule); }
  @media (min-width: 700px) { .a-feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .a-feats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .a-feat { background: var(--sheet); padding: 0 0 24px; }
  .a-feat figure { border-bottom: var(--line) solid var(--rule); }
  .a-feat figure { margin: 0 0 20px; aspect-ratio: 4 / 3; overflow: hidden; }
  .a-feat figure img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .a-feat:hover figure img { transform: scale(1.04); }
  .a-feat h3, .a-feat ul { padding: 0 20px; }
  .a-feat ul { list-style: none; margin: 0; display: grid; gap: 8px; color: var(--ink-soft); font-size: var(--s-small); }
  .a-feat li { padding-left: 18px; position: relative; }
  .a-feat li::before { content: ''; position: absolute; left: 0; top: .6em; width: 8px; height: 2px; background: var(--ink); }

  .a-mail { background: var(--signal); border-top: var(--line) solid var(--rule); padding: 96px 0 72px; }
  .a-mail h2 { font-size: var(--s-lead); font-weight: 600; max-width: 34ch; letter-spacing: 0; line-height: 1.4; }
  .a-addr { display: block; font-size: clamp(40px, 9.6vw, 160px); font-weight: 800; font-variation-settings: 'wdth' 80; letter-spacing: -0.03em; line-height: 1; color: var(--ink); text-decoration: none; margin: 48px 0 64px; overflow-wrap: anywhere; }
  .a-addr:hover { text-decoration: underline; text-decoration-thickness: 6px; text-underline-offset: 12px; }
  .a-routes { list-style: none; margin: 0; padding: 0; border: var(--line) solid var(--rule); }
  .a-routes > li { background: var(--signal); padding: 0; }
  .a-routes a { display: block; padding: 20px; font-weight: 650; text-decoration: none; transition: background-color .25s var(--ease); }
  .a-routes a:hover { background: var(--ink); color: var(--signal); }
  @media (min-width: 900px) { .a-routes { grid-template-columns: repeat(3, 1fr); } }
</style>
