---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FactStrip from '../components/FactStrip.astro';
import StatusTracker from '../components/StatusTracker.astro';
import PhaseBar from '../components/PhaseBar.astro';
import PersonCard from '../components/PersonCard.astro';
import ProofWall from '../components/ProofWall.astro';
import SourceNote from '../components/SourceNote.astro';
import { photos } from '../data/photos';
import { t, localePath, site, hasProof, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale) as Record<string, string>;
const L = (p: string) => localePath(locale, p);
const svc = ['space', 'dev', 'host', 'ops'];
const audiences = [
  { k: 'gov', href: L('/project') },
  { k: 'con', href: L('/work-with-us') },
  { k: 'par', href: L('/contact') + '?type=partner' },
];
---
<Base locale={locale} path="/" title={s.home_title} description={s.home_desc}>
  <Hero eyebrow={s.home_eyebrow} title={s.home_h1} lead={s.home_lead} photo="bakun" credit={s.credit_bakun}>
    <div class="btn-row">
      <a class="btn" href={L('/project')}>{s.cta_project}</a>
      <a class="btn ghost" href={L('/contact')}>{s.cta_contact}</a>
      {site.company.profilePdf && <a class="btn ghost" href={site.company.profilePdf} download>{s.profile_pdf}</a>}
    </div>
  </Hero>
  <FactStrip locale={locale} />

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{s.trk_eyebrow}</p>
        <h2>{s.trk_title}</h2>
        <p class="lead">{s.trk_lead}</p>
      </div>
      <div class="bezel reveal reveal-d1"><div class="core"><StatusTracker locale={locale} /></div></div>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{s.home_why_eyebrow}</p>
        <h2>{s.home_why_title}</h2>
      </div>
      <div class="bento">
        <figure class="photo-card b-photo reveal" style="margin:0">
          <Image src={photos.land} alt="" widths={[640, 1000, 1400]} sizes="(min-width: 900px) 700px, 100vw" format="webp" quality={72} />
          <span class="credit">{s.credit_land}</span>
          <figcaption class="cap"><h3>{s.home_land_t}</h3><p>{s.home_land_b}</p></figcaption>
        </figure>
        {[1, 2, 3].map((i) => (
          <div class={`card b-side reveal reveal-d${i}`}><span class="num">0{i}</span><h3>{s[`home_why_${i}_t`]}</h3><p>{s[`home_why_${i}_b`]}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{s.home_team_eyebrow}</p>
        <h2>{s.home_team_title}</h2>
        <p class="lead">{s.home_team_lead}</p>
      </div>
      <div class="grid grid-3">
        {site.team.map((p) => <PersonCard name={p.name} role={s[p.roleKey]} bio={s[p.bioKey]} photo={p.photo} />)}
      </div>
      <h3 class="reveal" style="margin:56px 0 20px">{s.home_adv_title}</h3>
      <div class="grid grid-2">
        {site.advisers.map((p) => <PersonCard honour wide name={p.name} role={s[p.roleKey]} bio={s[p.bioKey]} photo={p.photo} />)}
      </div>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{s.home_phase_eyebrow}</p>
        <h2>{s.project_phase_title}</h2>
        <p class="lead">{s.project_phase_body}</p>
      </div>
      <div class="bezel reveal"><div class="core"><PhaseBar locale={locale} /></div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <figure class="media reveal" style="margin:0">
        <Image src={photos.serverHall} alt={s.credit_server} widths={[560, 900, 1200]} sizes="(min-width: 900px) 560px, 100vw" format="webp" quality={72} />
        <span class="credit">{s.credit_server}</span>
      </figure>
      <div class="reveal reveal-d1">
        <p class="eyebrow">{s.home_build_eyebrow}</p>
        <h2>{s.home_build_title}</h2>
        <p class="lead">{s.home_build_lead}</p>
        <ul class="svc-list" style="margin-top:28px">
          {svc.map((k) => <li><div><h3>{s[`svc_${k}_t`]}</h3><p>{s[`svc_${k}_b`]}</p></div></li>)}
        </ul>
        <div class="btn-row"><a class="btn ghost" href={L('/services')}>{s.cta_services}</a></div>
      </div>
    </div>
  </section>

  {hasProof && (
    <section class="section tone-paper">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">{s.proof_eyebrow}</p>
          <h2>{s.proof_title}</h2>
        </div>
        <ProofWall locale={locale} />
      </div>
    </section>
  )}

  <section class="section dark">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{s.aud_eyebrow}</p>
        <h2>{s.aud_title}</h2>
      </div>
      <div class="grid grid-3 audience">
        {audiences.map((a, i) => (
          <a class={`card reveal reveal-d${i + 1}`} href={a.href}>
            <h3>{s[`aud_${a.k}_t`]}</h3>
            <p>{s[`aud_${a.k}_b`]}</p>
            <span class="go">{s[`aud_${a.k}_go`]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tone-paper" style="padding:48px 0"><div class="wrap"><SourceNote locale={locale} /></div></section>
</Base>
