---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { t, localePath, site, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
// Fill in src/data/site.json. credentials: { title, issuer, ref?, date? }; partners: { name, logo?, url? }
const creds = site.credentials as { title: string; issuer: string; ref?: string; date?: string }[];
const partners = site.partners as { name: string; logo?: string; url?: string }[];
---
<Base locale={locale} path="/credentials" title={s.cred_title} description={s.cred_desc}>
  <Hero compact eyebrow={s.cred_eyebrow} title={s.cred_h1} lead={s.cred_lead} />
  <section class="section">
    <div class="wrap">
      {creds.length > 0 && (
        <ul class="rule-list">
          {creds.map((c) => <li><strong>{c.title}</strong><span>{[c.issuer, c.ref, c.date].filter(Boolean).join(' · ')}</span></li>)}
        </ul>
      )}
      {partners.length > 0 && (
        <>
          <h2 style="margin-top:48px">{s.cred_partners_title}</h2>
          <div class="grid grid-4">
            {partners.map((p) => <div class="card">{p.logo ? <img src={p.logo} alt={p.name} loading="lazy" /> : <h3>{p.name}</h3>}</div>)}
          </div>
        </>
      )}
      <p class="lead" style="margin-top:32px">{s.cred_request}</p>
      <div class="btn-row"><a class="btn" href={localePath(locale, '/contact') + '?type=government'}>{s.cta_contact}</a></div>
    </div>
  </section>
</Base>
