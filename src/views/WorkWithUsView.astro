---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import { photos } from '../data/photos';
import { t, localePath, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale) as Record<string, string>;
---
<Base locale={locale} path="/work-with-us" title={s.work_title} description={s.work_desc}>
  <Hero compact photo="land" credit={s.credit_land} eyebrow={s.work_eyebrow} title={s.work_h1} lead={s.work_lead} />
  <section class="section">
    <div class="wrap split-2">
      <figure class="side-photo reveal "><Image src={photos.switchyard} alt={s.alt_switchyard} widths={[600, 900, 1200]} sizes="(min-width: 900px) 45vw, 100vw" format="webp" quality={70} /></figure>
      <div class="grid">{[1, 2, 3, 4].map((i) => <div class="card reveal"><h3>{s[`work_${i}_t`]}</h3><p>{s[`work_${i}_b`]}</p></div>)}</div>
    </div>
    <div class="wrap"><figure class="wide-photo reveal"><Image src={photos.land} alt={s.alt_land} widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} /></figure></div>
  </section>
  <section class="cta-band dark">
    <div class="wrap">
      <h2>{s.work_how_title}</h2>
      <p class="lead">{s.work_how_body}</p>
      <div class="btn-row"><a class="btn" href={localePath(locale, '/contact') + '?type=contractor'}>{s.work_cta}</a></div>
    </div>
  </section>
</Base>
