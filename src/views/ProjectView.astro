---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FactStrip from '../components/FactStrip.astro';
import SourceNote from '../components/SourceNote.astro';
import CtaBand from '../components/CtaBand.astro';
import StatusTracker from '../components/StatusTracker.astro';
import PhaseBar from '../components/PhaseBar.astro';
import { t, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale) as Record<string, string>;
const power = ['avail', 'baleh', '2030', '2035'];
const req = ['power', 'net', 'cool', 'people'];
---
<Base locale={locale} path="/project" title={s.project_title} description={s.project_desc}>
  <Hero compact photo="bakun" credit={s.credit_bakun} eyebrow={s.project_eyebrow} title={s.project_h1} lead={s.project_lead} />
  <FactStrip locale={locale} />

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><h2>{s.project_status_title}</h2></div>
      <div class="bezel reveal"><div class="core"><StatusTracker locale={locale} /></div></div>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head reveal"><h2>{s.project_phase_title}</h2><p class="lead">{s.project_phase_body}</p></div>
      <div class="bezel reveal"><div class="core"><PhaseBar locale={locale} /></div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal"><h2>{s.project_power_title}</h2><p class="lead">{s.project_power_lead}</p></div>
      <div class="grid grid-4">
        {power.map((k) => <div class="card stat reveal"><div class="v">{s[`power_${k}_v`]}</div><div class="l">{s[`power_${k}_l`]}</div></div>)}
      </div>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head reveal"><h2>{s.project_req_title}</h2><p class="lead">{s.project_req_lead}</p></div>
      <div class="grid grid-4">
        {req.map((k) => <div class="card reveal"><h3>{s[`req_${k}_t`]}</h3><p>{s[`req_${k}_b`]}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <h2>{s.project_market_title}</h2>
        <p>{s.market_1}</p>
        <p>{s.market_2}</p>
      </div>
      <SourceNote locale={locale} />
    </div>
  </section>
  <CtaBand locale={locale} />
</Base>
