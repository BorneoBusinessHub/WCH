---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FactStrip from '../components/FactStrip.astro';
import SourceNote from '../components/SourceNote.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale) as Record<string, string>;
const status = ['power', 'land', 'next'];
const power = ['avail', 'baleh', '2030', '2035'];
const req = ['power', 'net', 'cool', 'people'];
---
<Base locale={locale} path="/project" title={s.project_title} description={s.project_desc}>
  <Hero compact eyebrow={s.project_eyebrow} title={s.project_h1} lead={s.project_lead} />
  <FactStrip locale={locale} />

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{s.project_status_title}</h2></div>
      <ul class="rule-list">
        {status.map((k) => <li><strong>{s[`status_${k}_t`]}</strong><span>{s[`status_${k}_b`]}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head"><h2>{s.project_phase_title}</h2><p class="lead">{s.project_phase_body}</p></div>
      <figure class="phase" aria-label={s.phase_svg_title}>
        <figcaption>{s.phase_total_label}</figcaption>
        <div class="phase-bar">
          <div class="p1"><strong>2 MW</strong><span>{s.phase_1_label}</span></div>
          <div class="p2"><strong>8 MW</strong><span>{s.phase_2_label}</span></div>
        </div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{s.project_power_title}</h2><p class="lead">{s.project_power_lead}</p></div>
      <div class="grid grid-4">
        {power.map((k) => <div class="card stat"><div class="v">{s[`power_${k}_v`]}</div><div class="l">{s[`power_${k}_l`]}</div></div>)}
      </div>
    </div>
  </section>

  <section class="section tone-paper">
    <div class="wrap">
      <div class="section-head"><h2>{s.project_req_title}</h2><p class="lead">{s.project_req_lead}</p></div>
      <div class="grid grid-4">
        {req.map((k) => <div class="card"><h3>{s[`req_${k}_t`]}</h3><p>{s[`req_${k}_b`]}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <h2>{s.project_market_title}</h2>
        <p>{s.market_1}</p>
        <p>{s.market_2}</p>
      </div>
      <SourceNote locale={locale} />
    </div>
  </section>
  <CtaBand locale={locale} />
</Base>
