---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import credits from '../assets/found/credits.json';
import { t, localePath, otherLocale, hasCredentials, site, type Locale } from '../i18n/t';

interface Props { locale: Locale; path: string; title: string; description: string; noindex?: boolean }
const { locale, path, title, description, noindex = false } = Astro.props;
const s = t(locale) as Record<string, string>;
const other = otherLocale(locale);
const origin = 'https://wch.global';
const enUrl = origin + localePath('en', path);
const msUrl = origin + localePath('ms', path);
const canonical = locale === 'en' ? enUrl : msUrl;
const norm = (p: string) => p.replace(/^\/+|\/+$/g, '');
const L = (p: string) => localePath(locale, p);

// Five links and one action
const nav = [
  { path: '/project', label: s.nav_project },
  { path: '/about', label: s.nav_about },
  { path: '/services', label: s.nav_services },
  { path: '/governance', label: s.nav_governance },
  ...(hasCredentials ? [{ path: '/credentials', label: s.nav_credentials }] : []),
  { path: '/work-with-us', label: s.nav_work },
];
const { company } = site;
---
<!doctype html>
<html lang={locale === 'en' ? 'en-MY' : 'ms-MY'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="ms" href={msUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={locale === 'en' ? 'en_MY' : 'ms_MY'} />
  <meta name="theme-color" content="#f4f5f2" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">{s.skip}</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={L('/')}>
        <span class="wm">WCH</span><span class="wm-sub">Solutions</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={s.menu}><span></span><span></span></button>
      <nav class="nav" id="site-nav" aria-label="Main">
        {nav.map((n) => (
          <a href={L(n.path)} aria-current={norm(n.path) === norm(path) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="lang" href={localePath(other, path)} hreflang={other} lang={other === 'en' ? 'en' : 'ms'}>{s.lang_other}</a>
        <a class="nav-cta" href={L('/contact')} aria-current={norm(path) === 'contact' ? 'page' : undefined}>{s.nav_contact}</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap top">
      <div>
        <span class="lbl">WCH Solutions</span>
        <ul>
          <li><a href={L('/')}>{s.nav_home}</a></li>
          {nav.map((n) => <li><a href={L(n.path)}>{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <span class="lbl">{s.nav_contact}</span>
        <ul>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          {company.address && <li>{company.address}</li>}
          <li>{s.contact_place}</li>
        </ul>
      </div>
      <div>
        <span class="lbl">{s.lang_name}</span>
        <ul><li><a href={localePath(other, path)} hreflang={other}>{s.lang_other}</a></li></ul>
      </div>
    </div>
    <div class="wrap">
      <p class="word" aria-hidden="true">WCH</p>
      <div class="legal">
        <p>© {new Date().getFullYear()} {company.name}{company.ssm && ` (${s.footer_reg} ${company.ssm})`}. {s.footer_rights}</p>
        <p>{s.credits_title}: {s.credit_deck} {credits.map((c: { credit: string }) => c.credit).join('; ')}.</p>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('site-nav');
    btn?.addEventListener('click', () => {
      const open = nav!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav?.classList.contains('open')) btn?.click();
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
