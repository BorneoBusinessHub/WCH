---
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';
interface Props { title: string; lead: string; compact?: boolean; photo?: PhotoKey; credit?: string; eyebrow?: string }
const { title, lead, photo, credit } = Astro.props;
---
<section class:list={['hero', { 'has-media': photo }]}>
  <div class="grid-hero">
    <div class="copy">
      <h1 class="reveal">{title}</h1>
      <p class="lead reveal d1">{lead}</p>
      <div class="reveal d2"><slot /></div>
    </div>
    {photo && (
      <figure class="media">
        <Image src={photos[photo]} alt="" widths={[640, 1024, 1400]} sizes="(min-width: 960px) 42vw, 100vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
        {credit && <figcaption class="photo-credit">{credit}</figcaption>}
      </figure>
    )}
  </div>
</section>
