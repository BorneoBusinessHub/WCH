---
import { t, localePath, type Locale } from '../i18n/t';
const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
---
<section class="cta-band">
  <div class="wrap inner">
    <h2 class="reveal" style="color:var(--white);margin:0">{s.home_cta_title}</h2>
    <div class="reveal d1">
      <p class="lead" style="color:var(--on-dark-soft)">{s.home_cta_body}</p>
      <a class="btn" href={localePath(locale, '/contact')}>{s.cta_contact}</a>
    </div>
  </div>
</section>
